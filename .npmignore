# npm uses this allowlist because vsce rejects a package.json "files" field
# alongside .vscodeignore. Dependencies are bundled; only the Python helper
# needs to ship beside the MCP entry point.
*
!dist/
dist/*
!dist/mcp-server.js
!tools/
tools/*
!tools/log-analyzer/
tools/log-analyzer/*
!tools/log-analyzer/analyze_logs.py
!package.json
!README.md
!CHANGELOG.md
!LICENSE
